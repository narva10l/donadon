# Lo que NO debe entrar en la imagen.
# El .env lleva las contrasenas: solo se usa desde el host.

.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

.git/
.gitignore
README.md

# Script de Windows para correr las pruebas: solo sirven en el host.
probar.bat
probar-js.bat
probar-seguridad.bat

# --- Revision de seguridad ------------------------------------
# Los reportes se generan en seguridad/ y no son codigo.
# La pila desechable de OWASP ZAP tiene su propia imagen
# (Dockerfile.seguridad), asi que esto no lo necesita.
seguridad/
docker-compose.seguridad.yml
Dockerfile.seguridad

# --- Pruebas de JavaScript -------------------------------------
# La app no usa Node. Esto solo corre en la imagen de pruebas
# (Dockerfile.jest), que lo monta como volumen desde el host.
tests-js/
node_modules/
package.json
package-lock.json
jest.config.js
Dockerfile.jest
Dockerfile.jest.dockerignore

